# 이 파일을 .env로 복사하고 실제 DB와 임의의 32자 이상 비밀키를 입력합니다.
# URL 비밀번호에 @, :, / 등이 있으면 URL 인코딩하세요.
DATABASE_URL=mysql+pymysql://filmlog:YOUR_PASSWORD@YOUR_DB_HOST:3306/filmlog_server?charset=utf8mb4
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
APP_ENV=production
PUBLIC_ORIGIN=https://YOUR_HOST_NAME
SESSION_COOKIE_SECURE=true
HOST=127.0.0.1
PORT=58801
